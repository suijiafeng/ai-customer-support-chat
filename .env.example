# 示例模板。复制为 .env.local 并填入真实值即可。
# 加载优先级（高 → 低）：真实环境变量 > .env.local > .env（兜底）

# AI 模型：任意 OpenAI 兼容服务，不填 AI_API_KEY 则走本地规则模式
AI_ENABLED=false
AI_API_KEY=
# 预设厂商（自带接口地址与默认模型）：
# openai / deepseek / anthropic / gemini / zhipu / moonshot / qwen
# openrouter / groq / siliconflow / xai / ollama / custom
AI_PROVIDER=deepseek
# 以下两项可选，用于覆盖预设；custom 或自建网关时必填 AI_BASE_URL
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# Server
PORT=3001
# 内置静态站点开关（默认全开，关闭后对应路径返回 404，API 不受影响）：
# demo=根路径演示站，widget=/widget 嵌入脚本，workstation=/workstation 客服工作台。
# 拆分部署（前端走 CDN/独立容器）时通常全关，server 只保留 API。
# DEMO_ENABLED=true
# WIDGET_ENABLED=true
# WORKSTATION_ENABLED=true
# 客服 JWT 签名密钥。开发留空用内置默认值；生产必须设为随机值（缺失会拒绝启动）。
# 生成：openssl rand -hex 32
# AUTH_SECRET=

# 数据持久化（可选）：留空用内存；填 Postgres 连接串可持久化。
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 持久化写入失败告警（可选）：填一个接受 JSON POST { text: string } 的 webhook 地址
# （如 Slack Incoming Webhook）。留空则不发送任何告警。
# ALERT_WEBHOOK_URL=
