# AI Provider: openai | deepseek (leave API key blank to run in local rule mode)
AI_ENABLED=false
AI_PROVIDER=openai

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server
PORT=3001

# 数据持久化（可选）：留空则用内存（重启即清空，适合本地演示）。
# 填入外部 Postgres 连接串（如 Neon/Supabase）即可持久化会话/工单/消息。
# 托管库一般需要 SSL，连接串通常自带 ?sslmode=require。
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
