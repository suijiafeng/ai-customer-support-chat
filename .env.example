# ===== AI（可选）=====
# AI Provider: openai | deepseek (leave API key blank to run in local rule mode)
AI_PROVIDER=deepseek
AI_ENABLED=false

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 服务 =====
PORT=3001

# 客服 JWT 签名密钥。开发环境留空时使用内置默认值（仅限本机调试）；
# 演示/生产环境必须设置为随机值（生产缺失会拒绝启动）。生成方式：openssl rand -hex 32
# AUTH_SECRET=70a4cef98048094a67ae9e9b17291140d0b6b5044b9d66e84aadfc0a60161d44

# 数据持久化（可选）：留空则用内存（重启即清空，适合本地演示）。
# 填入外部 Postgres 连接串（如 Neon/Supabase）即可持久化会话/工单/消息。
# 托管库一般需要 SSL，连接串通常自带 ?sslmode=require。
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 数据目录（可选）：faqs.json / inquiries.json / agents.json 所在目录，
# 默认 apps/server/data；挂载外部数据卷时覆盖。
# DATA_DIR=
