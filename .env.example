# 示例模板。复制为 .env.local 并填入真实值即可。
# 加载优先级（高 → 低）：真实环境变量 > .env.local > .env（兜底）

# AI Provider: openai | deepseek（不填 API key 则走本地规则模式）
AI_PROVIDER=deepseek
AI_ENABLED=false

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server
PORT=3001
# 客服 JWT 签名密钥。开发留空用内置默认值；生产必须设为随机值（缺失会拒绝启动）。
# 生成：openssl rand -hex 32
# AUTH_SECRET=

# 数据持久化（可选）：留空用内存；填 Postgres 连接串可持久化。
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 持久化写入失败告警（可选）：填一个接受 JSON POST { text: string } 的 webhook 地址
# （如 Slack Incoming Webhook）。留空则不发送任何告警。
# ALERT_WEBHOOK_URL=
