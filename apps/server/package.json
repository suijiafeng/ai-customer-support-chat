{
  "name": "@assistflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "npm run build && concurrently --kill-others --success first \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --experimental-sqlite --disable-warning=ExperimentalWarning --watch dist/main.js\"",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@assistflow/shared": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "openai": "^6.9.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.1.0",
    "pg-mem": "^3.0.14",
    "typescript": "^5.6.3"
  }
}
