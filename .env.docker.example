# 本地 docker run 示例环境变量。
# 使用方式：
#   cp .env.docker.example .env.docker
#   修改 AUTH_SECRET / DATABASE_URL / AI Key
#   docker run --env-file .env.docker -p 3001:3001 assistflow

NODE_ENV=production
PORT=3001

# 生产镜像必须配置。生成方式：openssl rand -hex 32
AUTH_SECRET=replace-with-a-random-secret

# 留空则使用内存存储，容器重启后会话/消息/工单会丢失。
# 托管 Postgres 通常需要 sslmode=require。
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# AI 默认关闭，走本地 FAQ / 规则回复。
AI_ENABLED=false
AI_PROVIDER=deepseek

# 启用 DeepSeek 时设置：
# AI_ENABLED=true
# DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 启用 OpenAI 时设置：
# AI_ENABLED=true
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# 如需挂载自定义知识库目录，配合 docker run -v 使用。
# DATA_DIR=/app/apps/server/data
