# 兜底默认值（安全、可提交）。实际配置请写在 .env.local（覆盖本文件）。
# 加载优先级：真实环境变量 > .env.local > .env

# AI 模型：任意 OpenAI 兼容服务，不填 AI_API_KEY 则走本地规则模式
AI_ENABLED=false
AI_API_KEY=
# 预设厂商（自带接口地址与默认模型）：
# openai / deepseek / anthropic / gemini / zhipu / moonshot / qwen
# openrouter / groq / siliconflow / xai / ollama / custom
AI_PROVIDER=deepseek
# 以下两项可选，用于覆盖预设；custom 或自建网关时必填 AI_BASE_URL
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# 人工接管：客服静默 N 分钟后自动交还 AI（0 = 永不交还）；接管期间状态提示的最小间隔
# HANDOFF_IDLE_RELEASE_MINUTES=10
# HANDOFF_NOTICE_COOLDOWN_MINUTES=5

# Server
PORT=
# JWT 签名密钥。留空时会自动生成并持久化到 DATA_DIR/.auth_secret（重启复用）。
# 多实例部署务必显式设置统一值（否则各实例 token 互不认）。生成：openssl rand -hex 32
# AUTH_SECRET=
# CORS 白名单（逗号分隔）；留空则放开（公开 widget 需跨站调用）。
# 仅自用/已知宿主时建议收紧，例如：https://yoursite.com,https://app.yoursite.com
# CORS_ORIGINS=

# 数据持久化：
# 后端切换用 DB_DRIVER 显式指定：sqlite（默认）| postgres | memory。
# 不设 DB_DRIVER 时自动推断：配了 DATABASE_URL → postgres，否则 → sqlite。
# DB_DRIVER=sqlite
#
# - sqlite（默认）：零配置本地持久化，文件写入 DATA_DIR/assistflow.db，重启不丢。
#   需以 --experimental-sqlite 启动（npm run start 已自动带上）。可用 SQLITE_PATH 覆盖路径。
# - postgres：设置 DATABASE_URL 即可（或 DB_DRIVER=postgres）。
# - memory：纯内存，重启即清空，适合临时调试。
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# SQLITE_PATH=
# DATA_DIR=
